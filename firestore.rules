rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ─── Users Collection ──────────────────────────────────────────────
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuthenticated();
      // Only the user can create/delete their own profile
      allow create, delete: if isOwner(userId);
      // The user can update their own profile fully. Other authenticated users
      // may ONLY update the review/rating aggregate fields — this lets a boss
      // rate a worker (and vice-versa) without touching the rest of the profile.
      allow update: if isOwner(userId)
                    || (
                        isAuthenticated()
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['averageRating', 'totalRatings', 'rating'])
                    );

      // Favorites subcollection — only the boss can manage their favorites
      match /favorites/{workerId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── Work Offers ───────────────────────────────────────────────────
    match /workOffers/{offerId} {
      // All authenticated users can read offers
      allow read: if isAuthenticated();

      // Only the boss who created it can create their own offers
      allow create: if isAuthenticated()
                    && request.resource.data.bossId == request.auth.uid;

      // Allowed updates:
      //  - Boss editing their own offer
      //  - The assigned worker updating status (IN_PROGRESS / COMPLETED)
      //  - Any worker accepting a still-open offer
      // Uses .get('acceptedBy', null) so it works even when the field is absent.
      allow update: if isAuthenticated()
                    && (
                        resource.data.bossId == request.auth.uid
                        || resource.data.get('acceptedBy', null) == request.auth.uid
                        || (resource.data.get('acceptedBy', null) == null
                            && request.resource.data.acceptedBy == request.auth.uid)
                    );

      // Only the boss can delete their offer (if not yet accepted)
      allow delete: if isAuthenticated()
                    && resource.data.bossId == request.auth.uid
                    && resource.data.get('acceptedBy', null) == null;
    }

    // ─── Reviews ───────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      // Anyone authenticated can read reviews
      allow read: if isAuthenticated();

      // Only create reviews (no updates/deletes) — one per job enforced in app
      allow create: if isAuthenticated()
                    && request.resource.data.reviewerId == request.auth.uid;

      allow update, delete: if false;
    }

    // ─── Reports ───────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Reports are write-only for users (admin reads via console)
      allow create: if isAuthenticated()
                    && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ─── Admin Alerts (Cloud Functions only) ───────────────────────────
    match /adminAlerts/{alertId} {
      allow read, write: if false; // Only Cloud Functions can write
    }

    // ─── Notifications ─────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Users can read their own notifications
      allow read: if isAuthenticated()
                  && resource.data.recipientId == request.auth.uid;
      // Cloud Functions create notifications server-side; authenticated users
      // may also create notifications (e.g. a worker requesting a review from
      // the boss). Must target a recipient and start unread.
      allow create: if isAuthenticated()
                    && request.resource.data.recipientId is string
                    && request.resource.data.recipientId != ''
                    && request.resource.data.isRead == false;
      // Users can mark their own notifications as read
      allow update: if isAuthenticated()
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    // ─── Bookings ──────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isAuthenticated()
                  && (resource.data.bossId == request.auth.uid
                      || resource.data.get('workerId', '') == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
                    && (
                        resource.data.bossId == request.auth.uid
                        || resource.data.get('workerId', '') == request.auth.uid
                        // A worker accepting an unassigned (PENDING) booking
                        || (resource.data.get('workerId', '') == ''
                            && request.resource.data.workerId == request.auth.uid)
                    );
    }

    // ─── Payments (manual, two-sided confirmation — Phase 1, no gateway) ──
    // Doc id == jobId. Money moves off-app (cash / UPI); this is the audit record.
    // A boss may only flip `bossMarkedPaid`; a worker may only flip
    // `workerConfirmed`. Neither can set the other's flag, so PAID_OUT can only
    // ever be reached when BOTH parties have independently confirmed.
    match /payments/{jobId} {
      function isParticipant() {
        return resource.data.bossId == request.auth.uid
               || resource.data.workerId == request.auth.uid;
      }

      // NOTE: `get` must tolerate a missing document — the client reads the
      // payment doc inside a transaction BEFORE creating it, and for a
      // non-existent doc `resource` is null (which would otherwise deny).
      allow get: if isAuthenticated() && (resource == null || isParticipant());

      // Queries are constrained by bossId/workerId on the client, so per-doc
      // participant checks make the query provably safe.
      allow list: if isAuthenticated() && isParticipant();

      // First write: creator must be a participant and may only set their own flag.
      allow create: if isAuthenticated()
                    && (
                        (request.resource.data.bossId == request.auth.uid
                         && request.resource.data.workerConfirmed == false)
                        || (request.resource.data.workerId == request.auth.uid
                            && request.resource.data.bossMarkedPaid == false)
                    );

      allow update: if isAuthenticated()
                    && (
                        // Boss confirms payment sent — cannot touch worker's flag
                        (resource.data.bossId == request.auth.uid
                         && request.resource.data.workerConfirmed == resource.data.workerConfirmed)
                        // Worker confirms receipt — cannot touch boss's flag
                        || (resource.data.workerId == request.auth.uid
                            && request.resource.data.bossMarkedPaid == resource.data.bossMarkedPaid)
                    )
                    // Immutable financial facts
                    && request.resource.data.amount == resource.data.amount
                    && request.resource.data.bossId == resource.data.bossId
                    && request.resource.data.workerId == resource.data.workerId;

      // Payment history is permanent — no deletions.
      allow delete: if false;
    }

    // ─── Banners (read-only, managed via Firebase console) ─────────────
    match /banners/{bannerId} {
      allow read: if true; // Public read — banners shown on dashboards
      allow write: if false;
    }

    // ─── Config (read for all, write for authenticated users to seed) ───
    match /config/{configId} {
      allow read: if true; // Public read for categories
      allow write: if isAuthenticated(); // Allow app to seed categories
    }

    // ─── Chat Messages ─────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}

