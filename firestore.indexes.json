{
  "indexes": [
    {
      "//": "NotificationsScreen: whereEqualTo(recipientId) + orderBy(timestamp DESC)",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "recipientId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "timestamp",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Cloud Function updateWorkerLevelOnCompletion: acceptedBy + status",
      "collectionGroup": "workOffers",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "acceptedBy",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Cloud Function autoExpireStaleJobs: status + createdAt range",
      "collectionGroup": "workOffers",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}

