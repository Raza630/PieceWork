<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Allow resolving maps/navigation apps for turn-by-turn directions (Android 11+ package visibility) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:name=".WorkManApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:icon="@drawable/ic_workman_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_workman_logo"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.WorkMan"
        tools:targetApi="31">
        <activity
            android:name=".FavoriteWorkersActivity"
            android:exported="false"
            android:parentActivityName=".HomeBossDashboardActivity" />
        <activity
            android:name=".NotificationsActivity"
            android:exported="false" />
        <activity
            android:name=".ChatListActivity"
            android:exported="false" />
        <activity
            android:name=".MapPickerActivity"
            android:exported="false"
            android:parentActivityName=".CreateWorkActivity" />
        <activity
            android:name=".MyJobOffersActivity"
            android:exported="false"
            android:parentActivityName=".HomeBossDashboardActivity" />
        <activity
            android:name=".BossWorkListActivity"
            android:exported="false" />
        <activity
            android:name=".ChooseActivity"
            android:exported="false" />
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.WorkMan" />
        <activity
            android:name=".WorkerDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".HomeBossDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ChatActivity"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".Profile"
            android:launchMode="singleTop"
            android:exported="false" />
        <activity
            android:name=".SignInActivity"
            android:exported="false" />
        <activity
            android:name=".CreateWorkActivity"
            android:exported="false" />
        <activity
            android:name=".SignUp"
            android:exported="false" />

        <activity
            android:name=".RewardWebViewActivity"
            android:exported="false" />
        <activity
            android:name=".HomeWorkerDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".WorkOfferDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".WorkerJobsActivity"
            android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WorkMan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".notificationsModel.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          AndroidX AppCompat locale persistence. Enables automatic storage of the
          per-app language chosen via AppCompatDelegate.setApplicationLocales() so
          the selection survives app restarts on Android 12 (API 32) and below.
          On Android 13+ the platform stores it automatically.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>