<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude login/session prefs so a reinstall starts clean and a
             stale "logged in" flag is never restored from cloud backup. -->
        <exclude
            domain="sharedpref"
            path="UserPrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Same exclusion for device-to-device transfer. -->
        <exclude
            domain="sharedpref"
            path="UserPrefs.xml" />
    </device-transfer>
</data-extraction-rules>